# ==============================================================================
# Telegram NAS Backup Configuration (.env)
# ==============================================================================

# Timezone (for container and backup logs)
TIMEZONE=Asia/Ho_Chi_Minh

# Web Port for Teldrive Web UI & WebDAV
TELDRIVE_PORT=8080

# PostgreSQL Database Credentials
POSTGRES_USER=teldrive
POSTGRES_PASSWORD=replace_with_a_secure_password_here
POSTGRES_DB=teldrive

# Path to the data on your NAS that you want to backup (mounted as read-only)
# Example for Synology: /volume1/homes or /volume1/Photos
# Example for TrueNAS: /mnt/pool/data
NAS_SOURCE_PATH=/volume1/data

# Cron Schedule for automated backup (Default: 02:00 AM every night)
# Format: Minute Hour Day Month DayOfWeek
BACKUP_CRON=0 2 * * *

# Rclone Destination Remote (defined in rclone/rclone.conf)
RCLONE_DEST_REMOTE=teldrive-crypt:nas-backup

# Backup Performance & Anti-Flood Settings
# Limit upload speed to avoid saturating home internet and triggering Telegram rate limits (e.g. 10M, 15M, 20M)
RCLONE_BWLIMIT=15M
# Concurrent file transfers
RCLONE_TRANSFERS=4

# (Optional) Telegram Bot notifications for backup success / failure
# Create a bot via @BotFather to receive alert messages
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
