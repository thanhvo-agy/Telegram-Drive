# ==============================================================================
# SynoTele Vault Enterprise - Multi-NAS Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-NAS Node Role & Identity
# ------------------------------------------------------------------------------
# Tên định danh cho chiếc NAS này (ví dụ: Synology-Main-Office, Synology-Home-Replica)
NODE_NAME=Synology-DS920-Main

# Chế độ hoạt động của chiếc NAS này:
# - PUSH: NAS Chính (Source) -> Quét file nội bộ và ĐẨY LÊN Telegram Cloud Vault.
# - PULL: NAS Phụ (Replica / Chi nhánh / Nhà riêng) -> CHỈ NHẬN KÉO TỪ Telegram Cloud VỀ.
# - TWO_WAY: Đồng bộ 2 chiều (Bidirectional sync).
NODE_MODE=PUSH

# Đường dẫn dữ liệu khi NAS ở chế độ PUSH (thư mục gốc cần sao lưu):
NAS_SOURCE_PATH=/volume1/Photos

# Đường dẫn dữ liệu khi NAS ở chế độ PULL (thư mục cục bộ nhận file kéo về):
NAS_REPLICA_PATH=/volume1/replica_data

# Chiến lược khi PULL về NAS phụ:
# - SYNC: Đồng bộ giống 100% (nếu NAS chính xoá file, NAS phụ cũng xoá theo).
# - COPY: Chỉ nhận thêm (Append-Only: dù NAS chính xoá thì NAS phụ vẫn giữ lại vĩnh viễn).
PULL_STRATEGY=SYNC

# ------------------------------------------------------------------------------
# 2. Hệ Thống Mạng & Giao Diện Web
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Ho_Chi_Minh

# Cổng Web Quản Trị Google-Style Dashboard
DASHBOARD_PORT=8088

# Cổng Web Teldrive Backend & WebDAV Server
TELDRIVE_PORT=8080

# ------------------------------------------------------------------------------
# 3. Cơ Sở Dữ Liệu PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=teldrive
POSTGRES_PASSWORD=replace_with_a_secure_password_here
POSTGRES_DB=teldrive

# ------------------------------------------------------------------------------
# 4. Lịch Trình Chạy Ngầm (Trickle QoS)
# ------------------------------------------------------------------------------
# Lịch chạy tự động (Cron format - Mặc định: 02:00 AM hàng ngày)
BACKUP_CRON=0 2 * * *

# Rclone Destination Remote (đã định nghĩa trong rclone/rclone.conf)
RCLONE_DEST_REMOTE=teldrive-crypt:nas-backup

# Điều tiết tốc độ chạy ngầm thông minh (Smart Trickle Timetable):
# - 07:00 -> 23:00 (Ban ngày): Giới hạn 5MB/s, êm ái, nhường mạng gia đình và văn phòng.
# - 23:00 -> 07:00 (Ban đêm): Tăng lên 18MB/s để đẩy nhanh các tệp lớn.
RCLONE_BWLIMIT=07:00,5M 23:00,18M

# Số tệp chuyển đổi đồng thời (Nên để 2 để tối ưu CPU Synology và tránh Telegram Rate-limit)
RCLONE_TRANSFERS=2

# ------------------------------------------------------------------------------
# 5. Thông Báo Trạng Thái Qua Telegram Bot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
