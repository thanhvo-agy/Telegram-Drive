# ==============================================================================
# SynoTele Vault Enterprise - Cấu Hình Sao Lưu NAS Lên Telegram (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# ⚡ 1. CHỈ CẦN ĐIỀN 2 THÔNG SỐ NÀY LÀ HỆ THỐNG TỰ CHẠY NGẦM HOÀN HẢO!
# ------------------------------------------------------------------------------
# Lấy Bot Token từ @BotFather trên Telegram:
TELEGRAM_BOT_TOKEN=

# Chat ID hoặc Channel ID riêng tư nhận sao lưu (ví dụ: -1001234567890):
# Nhớ thêm Bot làm Quản Trị Viên (Admin) của Kênh này!
TELEGRAM_CHAT_ID=

# Đường dẫn thư mục dữ liệu trên máy chủ NAS bạn muốn bảo vệ:
NAS_SOURCE_PATH=/volume1/Photos

# Tốc độ tải ngầm Trickle QoS (MB/s) - Êm ái, nhường băng thông cho gia đình:
BW_LIMIT_MB=5.0

# Mật khẩu mã hoá AES-256 Zero-Knowledge (Nếu để trống sẽ tự sinh từ Bot Token):
ENCRYPTION_PASSWORD=

# Chu kỳ tự động quét & sao lưu tệp mới/sửa (Đơn vị: phút, Mặc định: 60 phút):
SCAN_INTERVAL_MIN=60

# ------------------------------------------------------------------------------
# 2. Cổng Web Dashboard (Tối ưu 100% không gian màn hình)
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Ho_Chi_Minh
DASHBOARD_PORT=8088
API_PORT=8089

# ------------------------------------------------------------------------------
# 3. Cấu hình Multi-NAS (Nếu triển khai nhiều trạm NAS PUSH/PULL)
# ------------------------------------------------------------------------------
NODE_NAME=Synology-DS920-Main

# - PUSH: NAS Chính -> Quét file nội bộ và ĐẨY LÊN Telegram Cloud Vault.
# - PULL: NAS Phụ -> CHỈ NHẬN KÉO TỪ Telegram Cloud VỀ.
NODE_MODE=PUSH
NAS_REPLICA_PATH=/volume1/replica_data
PULL_STRATEGY=SYNC

# ------------------------------------------------------------------------------
# 4. (Tuỳ chọn) Cấu hình Enterprise Teldrive v2 + Rclone Crypt (docker compose --profile enterprise up -d)
# ------------------------------------------------------------------------------
TELDRIVE_PORT=8080
POSTGRES_USER=teldrive
POSTGRES_PASSWORD=replace_with_a_secure_password_here
POSTGRES_DB=teldrive
BACKUP_CRON=0 2 * * *
RCLONE_DEST_REMOTE=teldrive-crypt:nas-backup
RCLONE_BWLIMIT=07:00,5M 23:00,18M
RCLONE_TRANSFERS=2
